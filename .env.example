# Application Configuration
APP_NAME=effortless-api
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000
COMPOSE_PROJECT_NAME=effortless-backend

# Sarvam AI Credentials & Settings
# Get your API key at https://dashboard.sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_SPEECH_MODEL=saaras:v4
SARVAM_TRANSLATION_MODEL=mayura:v1

# Google Cloud Identity Platform
GCP_PROJECT_ID=your_gcp_project_id
GCP_IDENTITY_WEB_API_KEY=your_gcp_identity_web_api_key
GCP_TEST_USER_EMAIL=your-test-user@example.com
AUTH_CHECK_REVOKED=true

# Cashfree payments and subscriptions
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
CASHFREE_WEBHOOK_SECRET=your_cashfree_webhook_secret
CASHFREE_ENVIRONMENT=sandbox

# Tier limits and free trial defaults
FREE_TIER_DAYS=7
FREE_TIER_MAX_SECONDS=10
FREE_TIER_MAX_REQUESTS_PER_DAY=10

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/effortless
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=effortless
DOCKER_DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/effortless
DOCKER_POSTGRES_HOST=postgres
DOCKER_POSTGRES_PORT=5432
POSTGRES_CONTAINER_NAME=effortless-backend-postgres
POSTGRES_VOLUME_NAME=effortless_backend_postgres_data

# Redis cache
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
DOCKER_REDIS_URL=redis://redis:6379/0
DOCKER_REDIS_HOST=redis
DOCKER_REDIS_PORT=6379
REDIS_CONTAINER_NAME=effortless-backend-redis
REDIS_VOLUME_NAME=effortless_backend_redis_data

# Docker Compose resources
BACKEND_CONTAINER_NAME=effortless-backend-api
BACKEND_NETWORK_NAME=effortless-backend-network
